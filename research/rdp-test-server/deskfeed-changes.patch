+/* Deskfeed test addition: the client's new monitor layout. Runs on the
+ * channel's thread; the peer thread applies it (sf_apply_pending_resize). */
+static UINT sf_disp_monitor_layout(DispServerContext* disp,
+                                   const DISPLAY_CONTROL_MONITOR_LAYOUT_PDU* pdu)
+{
+	testPeerContext* context = (testPeerContext*)disp->custom;
+	if (!pdu || pdu->NumMonitors < 1)
+		return CHANNEL_RC_OK;
+	const UINT32 w = pdu->Monitors[0].Width;
+	const UINT32 h = pdu->Monitors[0].Height;
+	WLog_INFO(TAG, "DESKFEED-TEST monitor layout %" PRIu32 "x%" PRIu32, w, h);
+	if ((w == 0) || (h == 0) || (w > 0xFFFF) || (h > 0xFFFF))
+		return CHANNEL_RC_OK;
+	(void)__atomic_exchange_n(&context->pending_size, (LONG)((w << 16) | h), __ATOMIC_SEQ_CST);
+	(void)SetEvent(context->resize_event);
+	return CHANNEL_RC_OK;
+}
+
+/* Deskfeed test addition: resize the desktop like the 'g' key handler. */
+static BOOL sf_apply_pending_resize(freerdp_peer* client)
+{
+	testPeerContext* context = (testPeerContext*)client->context;
+	rdpSettings* settings = client->context->settings;
+	(void)ResetEvent(context->resize_event);
+	const LONG v = __atomic_exchange_n(&context->pending_size, 0, __ATOMIC_SEQ_CST);
+	if (v == 0)
+		return TRUE;
+	const UINT32 w = ((UINT32)v >> 16) & 0xFFFF;
+	const UINT32 h = (UINT32)v & 0xFFFF;
+	if ((w == freerdp_settings_get_uint32(settings, FreeRDP_DesktopWidth)) &&
+	    (h == freerdp_settings_get_uint32(settings, FreeRDP_DesktopHeight)))
+		return TRUE;
+	if (!freerdp_settings_set_uint32(settings, FreeRDP_DesktopWidth, w) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopHeight, h))
+		return FALSE;
+	if (!rfx_context_reset(context->rfx_context, w, h))
+		return FALSE;
+	WLog_INFO(TAG, "DESKFEED-TEST desktop resized to %" PRIu32 "x%" PRIu32, w, h);
+	if (!client->context->update->DesktopResize(client->context->update->context))
+		return FALSE;
+	context->activated = FALSE;
+	return TRUE;
+}
